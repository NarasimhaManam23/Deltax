# Database URL: PostgreSQL in production (Render), SQLite for local development
# Example Render Postgres: postgresql://deltax_user:password@dpg-xxxx-a.oregon-postgres.render.com/deltax_prep
# Example Local SQLite: sqlite:///./deltax_prep.db
DATABASE_URL=sqlite:///./deltax_prep.db

# Comma-separated CORS allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://deltax-prep-frontend.onrender.com

# Server port (Render automatically injects PORT)
PORT=8000
